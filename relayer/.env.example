# ---- Relayer (never commit the real .env) ----
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# The relayer account pays all gas, creates learner sub-accounts and is the
# owner of bloqvia-core. On testnet this is bloqvia.testnet.
RELAYER_ACCOUNT_ID=bloqvia.testnet
RELAYER_PRIVATE_KEY=ed25519:REPLACE_ME
CORE_CONTRACT_ID=core.bloqvia.testnet
PASSPORT_CONTRACT_ID=passport.bloqvia.testnet
# NEAR sent to every new learner account for its own storage (account + key).
LEARNER_FUNDING_NEAR=0.01
# Comma-separated origins allowed to call this relayer; https://*.lovable.app
# covers every Lovable preview/publish domain. On Railway set the same names
# as Variables (there is no .env file there; `npm start` reads the platform env).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000,https://*.lovable.app,https://bloqvia.app
PORT=8787

# NEAR AI Cloud (optional; without it the daily quest agent and Ask Bloq stay off).
# Key from https://cloud.near.ai -> API Keys. Models from GET /v1/models.
NEAR_AI_API_KEY=
NEAR_AI_MODEL_QUEST=Qwen/Qwen3.6-35B-A3B-FP8
NEAR_AI_MODEL_CHAT=z-ai/glm-5.3-flash
# Ask Bloq: model calls allowed per UTC day across all players (protects the credit). Default 400.
ASK_DAILY_CAP=400
# Shared secret for POST /admin/quest (generate today's quest on demand). Any long random string.
ADMIN_TOKEN=
# The cohort DAO (Module B). Seats for graduates and founders live on its policy (relayer/src/seats.ts).
DAO_ID=bloqvia-dao.sputnik-v2.testnet
# The NPC trader (relayer/src/trader.ts): a learner account the relayer plays. Make it once with
# `cd scripts && npm run trader:create`, paste what it prints. Leave empty and the trader is off.
TRADER_ACCOUNT_ID=
TRADER_PRIVATE_KEY=
TRADER_INTERVAL_MIN=5
# Two more traders with other temperaments (Nov 11): TRADER2_* is the bull (buys on a 1-gold dip), TRADER3_* the bear
# (sells on a 1-gold rise). Make each with `npm run trader:create` once. Leave empty and only the patient one runs.
TRADER2_ACCOUNT_ID=
TRADER2_PRIVATE_KEY=
TRADER3_ACCOUNT_ID=
TRADER3_PRIVATE_KEY=
# The trader thinks (Nov 11): with NEAR_AI_API_KEY set, an agent picks its move among the ones the rules allow. TRADER_MIND=rules turns that off.
# TRADER_MIND=rules
# TRADER_MODEL=z-ai/glm-5.3-flash
# Fast-forward (relayer/src/fastforward.ts): players per run, minutes between runs, runs per day.
FF_PLAYERS=4
FF_EVERY_MIN=10
FF_DAILY_CAP=24
# the fast-forward also runs by itself every this many hours (0: only on the shop's button)
FF_AUTO_HOURS=2
# Abuse limits (relayer/src/http.ts, Nov 11): the relayer pays for every account and every relayed call.
REGISTER_PER_IP_PER_HOUR=6
REGISTER_PER_DAY=400
RELAY_PER_IP_PER_MIN=120
# The market desk (Nov 13): the relayer sells its market signal and signed Passport proofs over x402, paid in wNEAR to
# RELAYER_ACCOUNT_ID (DESK_PAY_TO to change). DESK=off turns it off. DESK_PUBLIC_URL is the address the 402s name and
# the only host the purses may pay: set it to the hosted relayer's URL there (https://relay.bloqvia.app).
# DESK_PUBLIC_URL=http://localhost:8787
# DESK=off
# The purses (Nov 13): what each NPC trader may spend on the desk's signal; made by `npm run x402:setup` in scripts/.
# Sub-accounts of the relayer with a full-access key each (x402 needs one) and a wrapped-NEAR balance that is the ceiling.
PURSE_ACCOUNT_ID=
PURSE_PRIVATE_KEY=
PURSE2_ACCOUNT_ID=
PURSE2_PRIVATE_KEY=
PURSE3_ACCOUNT_ID=
PURSE3_PRIVATE_KEY=
# PURSE_MAX_PER_CALL_YOCTO=10000000000000000000000   # 0.01 wNEAR a request (the signal's price)
# PURSE_DAILY_BUDGET_YOCTO=200000000000000000000000  # 0.2 wNEAR a day per purse
# The house purse (Nov 14): buys the day's sponsored slot (0.5 wNEAR) when nobody else did; `npm run x402:setup -- --apply --house`.
PURSE_HOUSE_ACCOUNT_ID=
PURSE_HOUSE_PRIVATE_KEY=
