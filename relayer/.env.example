# ---- Relayer (never commit the real .env) ----
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# The relayer account pays all gas, creates learner sub-accounts and is the
# owner of bloqvia-core. On testnet this is bloqvia.testnet.
RELAYER_ACCOUNT_ID=bloqvia.testnet
RELAYER_PRIVATE_KEY=ed25519:REPLACE_ME
CORE_CONTRACT_ID=core.bloqvia.testnet
PASSPORT_CONTRACT_ID=passport.bloqvia.testnet
# NEAR sent to every new learner account for its own storage (account + key).
LEARNER_FUNDING_NEAR=0.01
# Comma-separated origins allowed to call this relayer; https://*.lovable.app
# covers every Lovable preview/publish domain. On Railway set the same names
# as Variables (there is no .env file there; `npm start` reads the platform env).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000,https://*.lovable.app,https://bloqvia.com
PORT=8787

# NEAR AI Cloud (optional; without it the daily quest agent and Ask Bloq stay off).
# Key from https://cloud.near.ai -> API Keys. Models from GET /v1/models.
NEAR_AI_API_KEY=
NEAR_AI_MODEL_QUEST=Qwen/Qwen3.6-35B-A3B-FP8
NEAR_AI_MODEL_CHAT=z-ai/glm-5.3-flash
# Shared secret for POST /admin/quest (generate today's quest on demand). Any long random string.
ADMIN_TOKEN=
