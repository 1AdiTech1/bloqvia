                </Shape>

                <!-- Legs: hip pivot at the top centre of the leg (artboard x 124 / 196, y 262). -->
                <Node x="-36" y="-2" name="Leg R" id="0:60">
                    <Node x="0" y="54" name="Boot R" id="0:61">
                        <!-- One path: shaft 50 wide easing out to a 64-wide foot that flares outward. -->
                        <Shape name="Boot R Shape" id="0:62">
                            <PointsPath isClosed="true" name="Path">
                                <StraightVertex x="-25" y="-8" radius="8"/>
                                <StraightVertex x="25" y="-8" radius="8"/>
                                <CubicDetachedVertex x="25" y="10" inRotation="-1.5708" inDistance="4" outRotation="1.5708" outDistance="8"/>
                                <CubicDetachedVertex x="28" y="28" inRotation="-1.5708" inDistance="8" outRotation="1.5708" outDistance="4"/>
                                <StraightVertex x="28" y="46" radius="9"/>
                                <StraightVertex x="-36" y="46" radius="9"/>
                                <CubicDetachedVertex x="-36" y="28" inRotation="1.5708" inDistance="4" outRotation="-1.5708" outDistance="10"/>
                                <CubicDetachedVertex x="-25" y="8" inRotation="1.5708" inDistance="10" outRotation="-1.5708" outDistance="4"/>
                            </PointsPath>
                            <Fill name="Fill"><SolidColor colorValue="FFC9FF4D" name="Lime"/></Fill>
                        </Shape>
                    </Node>
                    <Shape x="0" y="26" name="Leg R Shape" id="0:63">
                        <Rectangle width="36" height="56" cornerRadiusTL="8" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FF9B3BFF" name="Violet"/></Fill>
                    </Shape>
                </Node>

                <Node x="36" y="-2" name="Leg L" id="0:70">
                    <Node x="0" y="54" name="Boot L" id="0:71">
                        <Shape name="Boot L Shape" id="0:72">
                            <PointsPath isClosed="true" name="Path">
                                <StraightVertex x="-25" y="-8" radius="8"/>
                                <StraightVertex x="25" y="-8" radius="8"/>
                                <CubicDetachedVertex x="25" y="8" inRotation="-1.5708" inDistance="4" outRotation="1.5708" outDistance="10"/>
                                <CubicDetachedVertex x="36" y="28" inRotation="-1.5708" inDistance="10" outRotation="1.5708" outDistance="4"/>
                                <StraightVertex x="36" y="46" radius="9"/>
                                <StraightVertex x="-28" y="46" radius="9"/>
                                <CubicDetachedVertex x="-28" y="28" inRotation="1.5708" inDistance="4" outRotation="-1.5708" outDistance="8"/>
                                <CubicDetachedVertex x="-25" y="10" inRotation="1.5708" inDistance="8" outRotation="-1.5708" outDistance="4"/>
                            </PointsPath>
                            <Fill name="Fill"><SolidColor colorValue="FFC9FF4D" name="Lime"/></Fill>
                        </Shape>
                    </Node>
                    <Shape x="0" y="26" name="Leg L Shape" id="0:73">
                        <Rectangle width="36" height="56" cornerRadiusTL="8" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FF9B3BFF" name="Violet"/></Fill>
                    </Shape>
                </Node>
            </Node>
        </Node>

        <!-- BloqFlow. The "expression" input (0-9) picks the Expression Solo's child:
             AnyState jumps to the matching state, whose one-key timeline sets
             activeComponentId. Body poses go on their own layer later. -->
        <StateMachine name="BloqFlow" id="0:7">
            <StateMachineNumber name="expression" value="0" id="0:300"/>
            <StateMachineLayer name="Expression" id="0:8">
                <EntryState x="0" y="-150">
                    <StateTransition stateToId="0:310"/>
                </EntryState>
                <AnyState x="0" y="0">
                    <StateTransition stateToId="0:310"><TransitionNumberCondition inputId="0:300" value="0"/></StateTransition>
                    <StateTransition stateToId="0:311"><TransitionNumberCondition inputId="0:300" value="1"/></StateTransition>
                    <StateTransition stateToId="0:312"><TransitionNumberCondition inputId="0:300" value="2"/></StateTransition>
                    <StateTransition stateToId="0:313"><TransitionNumberCondition inputId="0:300" value="3"/></StateTransition>
                    <StateTransition stateToId="0:314"><TransitionNumberCondition inputId="0:300" value="4"/></StateTransition>
                    <StateTransition stateToId="0:315"><TransitionNumberCondition inputId="0:300" value="5"/></StateTransition>
                    <StateTransition stateToId="0:316"><TransitionNumberCondition inputId="0:300" value="6"/></StateTransition>
                    <StateTransition stateToId="0:317"><TransitionNumberCondition inputId="0:300" value="7"/></StateTransition>
                    <StateTransition stateToId="0:318"><TransitionNumberCondition inputId="0:300" value="8"/></StateTransition>
                    <StateTransition stateToId="0:319"><TransitionNumberCondition inputId="0:300" value="9"/></StateTransition>
                </AnyState>
                <ExitState x="0" y="150"/>
                <AnimationState x="350" y="-270" animationId="0:400" id="0:310"/>
                <AnimationState x="350" y="-210" animationId="0:401" id="0:311"/>
                <AnimationState x="350" y="-150" animationId="0:402" id="0:312"/>
                <AnimationState x="350" y="-90" animationId="0:403" id="0:313"/>
                <AnimationState x="350" y="-30" animationId="0:404" id="0:314"/>
                <AnimationState x="350" y="30" animationId="0:405" id="0:315"/>
                <AnimationState x="350" y="90" animationId="0:406" id="0:316"/>
                <AnimationState x="350" y="150" animationId="0:407" id="0:317"/>
                <AnimationState x="350" y="210" animationId="0:408" id="0:318"/>
                <AnimationState x="350" y="270" animationId="0:409" id="0:319"/>
            </StateMachineLayer>
        </StateMachine>

        <LinearAnimation duration="1" name="Face Happy" id="0:400">
