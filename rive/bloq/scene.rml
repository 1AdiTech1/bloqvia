<Rive version="1" kind="fragment">
    <!--
        Bloq, Bloqvia's mascot. Front view, Idle pose. 320x400, transparent
        (no artboard fill).

        Proportions are measured from the "Idle" frame on reference/sheet-2.jpg
        and scaled 2.5x: head top y=40, boot soles y=362, centre x=160.

        L / R are the character's own left and right, so "L" parts sit on the
        viewer's right.

        Rig: every joint is a Node placed at the pivot; the art hangs off it as
        a Shape. Rotate the Node to swing the limb.
            Root (ground centre)
            └ Torso (hip line)
              ├ Upper Arm R/L (shoulder) → Forearm (elbow) → Hand (wrist)
              ├ Head (neck) ─ Expression (Solo), Screen, Glow, Head Shell, Ear R/L
              ├ Torso Body
              ├ Neck
              └ Leg R/L (hip) → Boot (ankle)

        Draw order: the first sibling paints on top. The arms come first so a
        raised arm passes in front of the head and torso.

        Face: the Expression Solo shows one child group at a time. State machine
        "BloqFlow", number input "expression": 0 Happy, 1 Excited, 2 Thinking,
        3 Winking, 4 Surprised, 5 Celebrating, 6 Curious, 7 Helping,
        8 Confused, 9 Cool. Happy through Helping follow sheet-2's icons;
        Confused and Cool exist only on sheet-1.
    -->
    <Artboard defaultStateMachineId="0:7" styleId="0:5" width="320" height="400" name="Bloq" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <Node x="160" y="362" name="Root" id="0:20">
            <Node x="0" y="-98" name="Torso" id="0:21">

                <!-- Arms. Shoulder pivot 8px inside the top centre of the upper arm
                     (artboard x 80 / 240, y 200); bind pose angled 3 degrees out. -->
                <Node x="-80" y="-64" rotation="0.0523599" name="Upper Arm R" id="0:40">
                    <Shape x="-8" y="13" name="Upper Arm R Shape" id="0:41">
                        <Rectangle width="44" height="58" linkCornerRadius="false"
                                   cornerRadiusTL="22" cornerRadiusTR="6"
                                   cornerRadiusBL="10" cornerRadiusBR="10" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FFFFD84D" name="Yellow"/></Fill>
                    </Shape>
                    <Node x="-8" y="38" name="Forearm R" id="0:42">
                        <Node x="0" y="20" name="Hand R" id="0:43">
                            <Shape x="0" y="16" name="Hand R Shape" id="0:44">
                                <Rectangle width="46" height="36" cornerRadiusTL="14" name="Path"/>
                                <Fill name="Fill"><SolidColor colorValue="FFE040FB" name="Hot Pink"/></Fill>
                            </Shape>
                        </Node>
                        <Shape x="0" y="7" name="Forearm R Shape" id="0:45">
                            <Rectangle width="34" height="30" cornerRadiusTL="10" name="Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FF7A3BFF" name="Purple"/></Fill>
                        </Shape>
                    </Node>
                </Node>

                <Node x="80" y="-64" rotation="-0.0523599" name="Upper Arm L" id="0:50">
                    <Shape x="8" y="13" name="Upper Arm L Shape" id="0:51">
                        <Rectangle width="44" height="58" linkCornerRadius="false"
                                   cornerRadiusTL="6" cornerRadiusTR="22"
                                   cornerRadiusBL="10" cornerRadiusBR="10" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FFFFD84D" name="Yellow"/></Fill>
                    </Shape>
                    <Node x="8" y="38" name="Forearm L" id="0:52">
                        <Node x="0" y="20" name="Hand L" id="0:53">
                            <Shape x="0" y="16" name="Hand L Shape" id="0:54">
                                <Rectangle width="46" height="36" cornerRadiusTL="14" name="Path"/>
                                <Fill name="Fill"><SolidColor colorValue="FFE040FB" name="Hot Pink"/></Fill>
                            </Shape>
                        </Node>
                        <Shape x="0" y="7" name="Forearm L Shape" id="0:55">
                            <Rectangle width="34" height="30" cornerRadiusTL="10" name="Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FF7A3BFF" name="Purple"/></Fill>
                        </Shape>
                    </Node>
                </Node>

                <!-- Head: pivot at the neck, the bottom centre of the head (artboard 160,160). -->
                <Node x="0" y="-104" name="Head" id="0:30">

                    <!-- Face, centred on the screen (artboard 160,98). One child per expression;
                         activeComponentId is keyed by the BloqFlow timelines below. -->
                    <Solo x="0" y="-62" activeComponentId="0:100" name="Expression" id="0:31">

                        <Node name="Happy" id="0:100">
                            <Shape x="-41" y="-6" name="Eye R" id="0:101">
                                <Rectangle width="36" height="30" cornerRadiusTL="8" name="Path"/>
                                <Fill name="Fill"><SolidColor colorValue="FF00E5FF" name="Cyan"/></Fill>
                            </Shape>
