# Web app (Vite). Copy to .env.local in the project root.
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
VITE_CORE_CONTRACT_ID=core.bloqvia.testnet
VITE_PASSPORT_CONTRACT_ID=passport.bloqvia.testnet
# hosted relayer (Railway); use http://localhost:8787 when running relayer/ locally
VITE_RELAYER_URL=https://relay.bloqvia.app
VITE_EXPLORER_BASE=https://testnet.nearblocks.io
# default is NEAR testnet through src/near; set to "mock" for the in-memory mock (design work without the chain)
VITE_GAME_MODE=near
VITE_STREAK_CONTRACT_ID=streak.bloqvia.testnet
